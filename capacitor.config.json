{
  "appId": "com.fugames.turkiyemulkimparatoru",
  "appName": "Türkiye Mülk İmparatoru",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "https",
    "errorPath": "index.html",
    "allowNavigation": [
      "*.supabase.co",
      "*.openstreetmap.org",
      "*.basemaps.cartocdn.com",
      "dene3230-svg.github.io"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#181F29"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#D97706",
      "sound": "default"
    }
  }
}
